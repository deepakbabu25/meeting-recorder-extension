{
  "manifest_version": 3,
  "name": "WebEnoid",
  "version": "1.0.0",
  "permissions": [
    "tabCapture",
    "activeTab",
    "storage",
    "offscreen",
    "sidePanel",
    "alarms",
    "identity"
  ],
  "icons": {
    "16": "icon 16 x 16.png",
    "48": "icon 48 x 48.png",
    "128": "icon 128 x 128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon 16 x 16.png",
      "48": "icon 48 x 48.png",
      "128": "icon 128 x 128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel-dist/index.html"
  },
  "oauth2": {
    "client_id": "904444073634-89a1662dj91g8341td3uublhe9e2873q.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  }
}